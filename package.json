{
  "name": "nexus-ppfl",
  "private": true,
  "version": "0.1.0",
  "description": "Privacy-Preserving Federated Learning engine native to Node.js",
  "type": "module",
  "license": "MIT",
  "author": "Amirezalla",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amirezalla/PPFL.git"
  },
  "bugs": {
    "url": "https://github.com/amirezalla/PPFL/issues"
  },
  "homepage": "https://github.com/amirezalla/PPFL#readme",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build -w @nexus-ppfl/crypto -w @nexus-ppfl/network -w @nexus-ppfl/ml-engine",
    "clean": "npm run clean --workspaces --if-present",
    "typecheck": "npm run typecheck -w @nexus-ppfl/crypto -w @nexus-ppfl/network -w @nexus-ppfl/ml-engine",
    "test": "npm run build && npm run test -w @nexus-ppfl/crypto -w @nexus-ppfl/network -w @nexus-ppfl/ml-engine",
    "cluster:test": "npm run build && node scripts/test-cluster.ts"
  },
  "devDependencies": {
    "@types/node": "^20.16.11",
    "typescript": "^5.6.3"
  }
}
