{
  "name": "@nexus-ppfl/crypto",
  "version": "0.1.0",
  "description": "Differential privacy and secure aggregation primitives for Nexus-PPFL",
  "keywords": [
    "differential-privacy",
    "secure-aggregation",
    "shamir-secret-sharing",
    "federated-learning",
    "privacy-preserving",
    "cryptography"
  ],
  "license": "MIT",
  "author": "Amirezalla",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amirezalla/PPFL.git",
    "directory": "packages/crypto"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && cd dist-test && node --test"
  },
  "devDependencies": {
    "@types/node": "^20.16.11",
    "typescript": "^5.6.3"
  }
}
